# KuCoin API credentials (NEVER commit real keys)
# Create API key on KuCoin with only Trade permission (no Withdraw!)
# These must live on the server only. The frontend never receives them.

KUCOIN_API_KEY=your_api_key_here
KUCOIN_SECRET=your_secret_here
KUCOIN_PASSWORD=your_passphrase_here

# Optional
# KUCOIN_SANDBOX=false

# Optional: POST JSON { text, alert } when the bot hard-stops
# HARD_STOP_WEBHOOK_URL=
